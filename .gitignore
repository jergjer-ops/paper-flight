# Keep local Edge Function secrets out of version control.
supabase/functions/.env
supabase/functions/.env.*
!supabase/functions/.env.example

# Supabase CLI stores machine-specific project state here.
supabase/.temp/

# Python cache files are generated locally and must not be published.
__pycache__/
*.py[cod]

# Android build artifacts (regenerate with scripts/mobile-sync.sh).
android/node_modules/
android/.temp/
android/android/build/
android/android/app/build/
android/android/capacitor-cordova-android-plugins/build/
android/android/.gradle/
android/android/.idea/
android/android/local.properties
android/android/app/src/main/assets/public/
